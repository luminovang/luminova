# Development Environment Configuration
# Documentation:
# https://luminova.ng/docs/0.0.0/global/env-variables

# Application Configurations

# Your application name
app.name = Your Application Name

# Your application hostname
app.hostname = example.com

# Set default application timezone
app.timezone = UTC

# Set default application locale
app.locale = en

# Application version code.
# Used for identifying the current application version and for static caching.
app.version = 1.0.0

# Application assets version.
# Can be incremented to force cache refresh for static assets.
app.file.version = 1.0.0

# Application encryption key.
# Auto-generated during Luminova installation. Can be manually changed if needed.
# Set your application key
app.key = 

# Application API URI prefix.
# This will serve as the base URI for all API endpoints.
app.api.prefix = api

# Modes: development, staging, production
app.environment.mood=production

# Maintenance mode
;app.maintenance.mood = true

# Maintenance refresh timeout
;app.maintenance.retry = 3600

# Set application HTML encoding
app.charset = utf-8

# Set the internal encoding for multibyte string functions
app.mb.encoding = UTF-8

# CLI
# [production, development and testing]
;cli.environment.mood = production 

# Disable X-Powered-By signature header
x.powered = false

# PAGE CACHING
 
# Default HTTP cache-control header for responses.
default.cache.control = no-store, max-age=0, no-cache

# Enable or disable page caching.
;page.caching = false

# Allow cached pages to be treated as immutable until they expire.
;page.caching.immutable = false

# Page cache lifetime in seconds.
;page.cache.expiry = 86400

# List of previous application versions (${app.version}) for cache fallback.
# If a cache entry doesn't exist in the latest version, the system will check these older versions.
# Example:
;page.cache.app.versions = [1.1.0, 1.2.0]

# List of views or URI patterns that should always use the latest application version (${app.version}).
# Entries here will ignore older cache and always use fresh content from the latest version.
# Example:
;page.cache.latest.content = [/]

# Enable serving static cached pages to improve performance.
# Specify file types using pipe symbols (|) for multiple extensions.
# Example: page.caching.statics = html|json|text|xml|css|js
# Do NOT include spaces around the pipe symbols (e.g., html|xml|css).
# This allows URLs to be accessed with or without the file extension, e.g.:
#   https://example.com/blog.html or https://example.com/blog
# Works with template view class content rendering types.
# The cached content type will determine the static access format.
;page.caching.statics = html|json

# Determines whether query parameters are included in cache keys.
# true  - Treat different query strings as separate cache entries.
# false - Ignore query parameters to reduce unnecessary cache fragmentation.
page.cache.query.params = false

# Preferred cache driver implementation (PSR-16 compatible).
# Supported drivers: 
# - filecache
# - memcached
# - redis
system.cache.driver = filecache

# Default cache persistent ID.
# Use as fallback when no (memcached.persistent.id or redis.persistent.id), was provided
;system.cache.persistent.id = default

# Cache serialization controls how cached data is serialized.
# 0 = auto (igbinary if available, otherwise serialize)
# 1 = serialize (PHP native serialization)
# 2 = igbinary (binary serializer, faster and smaller if extension is available)
# 3 = json (portable, human-readable, but loses PHP type fidelity)
# 4 = none (allow cache server to handle serialization)
system.cache.encoding.serializer = 0

# Enable or disable base64 encoding for stored cache payloads.
# Useful for binary-safe storage (e.g., file systems, databases, text-only stores).
system.cache.encoding.base64 = false

# Script execution

# Maximum script execution time in seconds.
# Set to 0 to disable the time limit.
;script.execution.limit = 30

# Continue executing the script after the client disconnects.
;script.ignore.abort = false

# OPTIMIZATION

# Output HTML minification
# Minifies HTML before sending it to the client by removing unnecessary
# comments and whitespace.
;output.minify.html = true

# Preserve HTML tags during HTML minification.
# Supported Tags:
# - script     = <script>
# - style      = <style>
# - textarea   = <textarea>
# - math       = <math>
# - svg        = <svg>
# - pre        = <pre> without code tag
# - code       = <pre><code> pres with code tag as child
output.minify.preserve.tags = ['pre', 'code', 'textarea']

# Code block action buttons.
# Supported Actions: 
# - copy = Add copy button.
# - ai   = Add AI button.
# - run  = Add run button.
;output.minify.codeblock.buttons = ['copy', 'ai', 'run']

# Response output compression
# Enable automatic HTTP response compression.
;output.compression.enable = true

# Optional PHP output buffer handler.
# Usually leave empty when using manual compression.
output.compression.handler = ob_gzhandler

# Minimum response size before compression is attempted (bytes).
# 1024
output.compression.min.length = 0

# Compression settings

# Supported encodings:
# auto|zstd|br|gzip|deflate|compress
output.compression.encoding = auto

# Compression level:
# zstd: 1-22
# br: 0-11
# gzip|deflate|compress: -1-9
output.compression.level = 6

# LOGGER

# The maximum size (in bytes) for each log level (e.g., 10485760 for 10 MB). 
# When this limit is reached, a backup of the log file is created if 
# `logger.create.backup` is set to true; otherwise, the logs are cleared.
;logger.max.size = 10485760

# Whether a backup of the log file should be created when the `logger.max.size` limit is reached. 
# Set to 'true' to automatically create a backup and empty the current log file; 
# 'false' to empty the log file only.
;logger.create.backup = true

# Strictly define log levels that should be sent to remote, email or telegram
# Default are alert, exception, emergency and critical
;logger.dispatch.levels = [critical,emergency,alert,exception]

# Email address
# Comment, leave empty or null if not in use. See /app/Errors/Defaults/mailer.php
;logger.mail.logs = logs@example.com

# Remote server address
# Comment, leave empty or null if not in use. See /app/Errors/Defaults/remote.php
;logger.remote.logs = https://example.com/api/logs

# Shared encryption key for remote logging
;logger.remote.sign.key = key:secret

# Telegram bot logging
# The telegram bot token
;logger.telegram.bot.token=
# The telegram bot chat ID
;logger.telegram.bot.chat.id=

# Whether to include the context data in telegram or slack log messages
;logger.remote.send.context = true

# Log message template format
# Placeholders: level, name, time, message, ipaddress, referer, useragent, and  context
;logger.log.format = '[{time:Y-m-d H:i:s.uP}] {level} {name} {message} {context}'


# Session

# Enable strict IP login session
;session.strict.ip = true


# Debugging

# Display PHP and application errors.
debug.display.errors = false

# Show performance optimization suggestions in production.
;debug.alert.performance.tips = true

# Throw exceptions on CLI
# Instead of rendering CLI error output when exceptions are thrown.
throw.cli.exceptions = true


# Memcached configuration

# Persistent connection identifier.
# Leave null to disable persistent connections.
;memcached.persistent.id = null

# Prefix applied to all cache keys.
;memcached.key.prefix = null

# Memcached server address.
memcached.host = 127.0.0.1

# Memcached server port.
memcached.port = 11211

# Server weight for load balancing.
# Higher values receive a greater share of requests.
;memcached.server.weight = 0


# SMTP Email configuration

# Enable SMTP authentication.
smtp.auth.enabled = false

# Require SMTP password authentication.
smtp.password.required = false

# Enable SMTP debug output.
smtp.debug = false

# SMTP server hostname.
smtp.host =

# SMTP server port.
# Common ports: 25, 465 (SSL), 587 (TLS).
smtp.port = 465

# SMTP username.
smtp.username =

# SMTP password.
smtp.password =

# Default sender email address.
smtp.sender.email = no-reply@example.com

# SMTP encryption mode.
# Supported: tls, ssl, null.
smtp.encryption = tls

# Email character encoding.
smtp.charset = utf8


# Database credentials

# Database server hostname or IP address.
database.hostname = localhost

# Database server port.
database.port = 3306

# Database username.
database.username = root

# Database name.
database.name = my_production_database

# Database password.
database.password =

# Choose any of these 2 database connection driver [mysqli or pdo]
database.connection = pdo

# Specify your PDO DBMS version or driver type:
# - mysql
# - sqlite
# - oci
# - dblib
# - cubrid
# - sqlsrv 
# - pgsql
#
# This is only applicable when database.connection is PDO. Not required for MYSQLI
database.pdo.driver = mysql

# Database socket configuration

# Use Unix socket connection instead of TCP.
# Enable this when running CLI tasks or when a socket connection is required.
;database.socket.connection = false

# Path to the database Unix socket file.
# Example: /var/run/mysqld/mysqld.sock
;database.socket.path = /path/to/mysql.sock


# SQLite configuration

# SQLite database file path.
# Used when the PDO SQLite driver is enabled.
;database.sqlite.path = /writeable/database/production.sqlite

# Database configuration

# Default character set.
database.charset = utf8mb4

# Enable connection pooling.
database.connection.pool = false

# Maximum number of pooled connections.
database.max.connections = 3

# Number of connection retry attempts on failure.
database.connection.retry = 1

# Use persistent database connections.
database.persistent.connection = false

# Enable buffered queries for MySQL.
database.mysql.buffered.query = false

# Emulate prepared statements instead of using native driver support.
# Supported in both PDO and MySQLi driver
database.emulate.prepares = true

# Set Initialization command
; database.commands = ["SET time_zone = '${app.timezone}'"]


# Database ORM Luminova\Database\Builder

# Choose the cache driver for database ORM builder class 
# Options (memcached or filecache, redis)
# Setting this will override `preferred.cache.driver` for builder
# ;depreciated database.caching.driver
database.orm.cache.driver = filecache

# Enable/Disable database ORM query builder global caching
# This can be override using $builder->cacheable(false)
database.orm.cache.enable = false

# FEATURES
# Enable or disable features. Value must be any of these [enable or disable] case sensitivity
# https://luminova.ng/docs/0.0.0/introduction/features

# Enable or disable PHP attribute routing.
feature.route.attributes = enable

# When attribute routing is enabled, use this option to cache route definitions in production.
# This ensures optimal performance instead of repassing attributes on each request
feature.route.cache.attributes = enable

# When enabled, attributes are scored and sorted according to score for better routing.
# This only run once if `feature.route.cache.attributes` is enabled.
route.optimize.attributes = enable

# Enable or disable dependency injection in routable controller methods
# or method-based routable callback handlers.
feature.route.dependency.injection = enable

# Enable or disable loading of custom global helper functions.
# Functions defined in /app/Utils/Global.php will be automatically loaded at runtime.
;feature.app.dev.functions = disable

# Enable or disable HMVC architecture.
# When enabled, Luminova uses modules with HMVC structure instead of plain MVC.
;feature.app.hmvc = enable